{
  "info": {
    "name": "SMS API Collection",
    "_postman_id": "12345678-aaaa-bbbb-cccc-1234567890ab",
    "description": "Postman collection for testing Student Management System APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "Students",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"gpa\": 3.5\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Get Student by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/1" }
        },
        {
          "name": "Get All Students",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students" }
        },
        {
          "name": "Get Students Sorted by GPA",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/sorted-by-gpa" }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"email\": \"updated@example.com\",\n  \"gpa\": 3.8\n}"
            },
            "url": "{{baseUrl}}/api/students/1"
          }
        },
        {
          "name": "Delete Student",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/students/1" }
        }
      ]
    },
